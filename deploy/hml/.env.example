# ============================================================
# Variáveis do stack de HOMOLOGAÇÃO
# ============================================================
# Crie o .env do servidor a partir deste arquivo (na pasta deploy/hml):
#   cp .env.example .env
# Depois edite .env com tokens e senhas reais. Se o seu .env for antigo, acrescente
# manualmente as linhas novas que existem aqui (ex.: MERCADO_PAGO_CHECKOUT_VALOR_OVERRIDE).

# Imagens publicadas pela CI no GHCR (substitua OWNER pelo seu usuário/org GitHub).
API_IMAGE=ghcr.io/OWNER/erpcorporativo-api:hml
WEB_IMAGE=ghcr.io/OWNER/erpcorporativo-web:hml

# Portas no loopback — devem bater com o Nginx em deploy/nginx/sites-available/
HOST_PORT_API_HML=9101
HOST_PORT_WEB_HML=9102

# MySQL — gere senhas fortes (32+ chars), nunca commitar
MYSQL_ROOT_PASSWORD=troque-esta-senha-forte
DB_NAME=clientes_hml
DB_USER=clientes_hml
DB_PASSWORD=troque-esta-senha-forte

# JWT — segredo do TokenService (gerar com: openssl rand -base64 48)
JWT_SECRET=troque-este-segredo

# Hibernate DDL: em HML deixamos update por padrão para iterar schema rapidamente.
# JPA_DDL_AUTO=update

# SMTP (opcional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Trial + Mercado Pago (obrigatório para checkout e webhook em HML) ---
# Token: TEST-... = checkout com faixa SANDBOX e cartões de teste (botão Pagar segue regras de teste do MP).
# Para dinheiro real: use credencial de PRODUÇÃO (APP_USR-...) e MERCADO_PAGO_PREFER_SANDBOX=false.
MERCADO_PAGO_ACCESS_TOKEN=
# URL pública desta API (mesmo host que o Nginx expõe em HTTPS).
MERCADO_PAGO_NOTIFICATION_URL=https://api.dev.erpcorporativo.shop/api/webhooks/mercadopago
# Base do Angular deste ambiente (back_urls da preferência MP).
APP_FRONTEND_URL=https://dev.erpcorporativo.shop
# true = preferir sandbox_init_point (só faz sentido com token de teste).
MERCADO_PAGO_PREFER_SANDBOX=true
# Força o valor cobrado na preferência Mercado Pago (planos e pedidos). Vazio ou ausente = preço real do banco.
MERCADO_PAGO_CHECKOUT_VALOR_OVERRIDE=1.00
# true = API loga o JSON completo da preferência antes do POST (contém e-mail; só debug).
# MERCADO_PAGO_LOG_PREFERENCE_PAYLOAD=true
# MERCADO_PAGO_LOG_PREFERENCE_RESPONSE=true
# MERCADO_PAGO_LOG_WEBHOOK_INBOUND=true

# Abacate Pay — checkout alternativo (POST /api/public/checkout/abacate). Chave no painel Abacate Pay.
ABACATEPAY_API_KEY=
