# ============================================================
# Variáveis do stack de HOMOLOGAÇÃO
# ============================================================

# Imagens publicadas pela CI no GHCR (substitua OWNER pelo seu usuário/org GitHub).
API_IMAGE=ghcr.io/OWNER/erpcorporativo-api:hml
WEB_IMAGE=ghcr.io/OWNER/erpcorporativo-web:hml

# Portas no loopback — devem bater com o Nginx em deploy/nginx/sites-available/
HOST_PORT_API_HML=9101
HOST_PORT_WEB_HML=9102

# MySQL — gere senhas fortes (32+ chars), nunca commitar
MYSQL_ROOT_PASSWORD=troque-esta-senha-forte
DB_NAME=clientes_hml
DB_USER=clientes_hml
DB_PASSWORD=troque-esta-senha-forte

# JWT — segredo do TokenService (gerar com: openssl rand -base64 48)
JWT_SECRET=troque-este-segredo

# SMTP (opcional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
