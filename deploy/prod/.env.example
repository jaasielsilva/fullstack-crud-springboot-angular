# ============================================================
# Variáveis do stack de PRODUÇÃO
# ============================================================

# Imagens publicadas pela CI no GHCR (substitua OWNER pelo seu usuário/org GitHub).
API_IMAGE=ghcr.io/OWNER/erpcorporativo-api:prod
WEB_IMAGE=ghcr.io/OWNER/erpcorporativo-web:prod

# Portas no loopback — devem bater com o Nginx em deploy/nginx/sites-available/
HOST_PORT_API_PROD=9103
HOST_PORT_WEB_PROD=9104

# MySQL — senhas DIFERENTES das de homologação
MYSQL_ROOT_PASSWORD=troque-esta-senha-forte
DB_NAME=clientes_prod
DB_USER=clientes_prod
DB_PASSWORD=troque-esta-senha-forte

# JWT — segredo do TokenService (gerar com: openssl rand -base64 48)
JWT_SECRET=troque-este-segredo

# Primeira subida com banco vazio: use update para criar o schema; depois troque para validate.
# JPA_DDL_AUTO=update

# SMTP (opcional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Mercado Pago (produção) ---
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_NOTIFICATION_URL=https://api.erpcorporativo.shop/api/webhooks/mercadopago
APP_FRONTEND_URL=https://erpcorporativo.shop
MERCADO_PAGO_PREFER_SANDBOX=false
# Opcional: forçar valor na preferência (quase sempre vazio em produção).
# MERCADO_PAGO_CHECKOUT_VALOR_OVERRIDE=

# Abacate Pay — https://api.erpcorporativo.shop/api/webhooks/abacatepay?webhookSecret=...
# 1) Painel Abacate Pay → API keys: crie chave v2 e use em ABACATEPAY_API_KEY (mesma conta dos produtos).
# 2) Painel → Produtos: crie "Plano Básico" (ex. R$ 29,90/mês) e "Plano Premium" (ex. R$ 49,90/mês); copie o ID (prod_…).
# 3) No servidor: ABACATEPAY_PRODUCT_ID_BASICO e ABACATEPAY_PRODUCT_ID_PREMIUM com esses IDs.
#    Erro "No products found" = IDs trocados, produto apagado, ou chave de outra conta.
# ABACATEPAY_API_KEY=
# ABACATEPAY_PRODUCT_ID_BASICO=
# ABACATEPAY_PRODUCT_ID_PREMIUM=
# ABACATEPAY_WEBHOOK_SECRET=
# ABACATEPAY_WEBHOOK_HMAC_KEY=

# --- Datadog → Telegram (alertas para super admin) ---
DATADOG_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# DATADOG_WEBHOOK_ALLOWED_IPS=
# DATADOG_WEBHOOK_LOG_PAYLOAD_PREVIEW=true
